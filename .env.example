# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# DATABASE_URL: PostgreSQL or SQLite connection string. Defaults to SQLite file in local/container dev.
DATABASE_URL="file:./dev.db"

# AUTH_SECRET: Secret used to sign session JWTs.
AUTH_SECRET="your-super-secret-jwt-token-key"

# APP_URL: The URL where this applet is hosted.
APP_URL=""

